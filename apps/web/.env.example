# Plain website: where the game server lives.
VITE_FLENS_SERVER=ws://localhost:8787

# Discord Activity. Only needed for the Discord build.
# From the Developer Portal → your application → OAuth2 → Client ID.
VITE_DISCORD_CLIENT_ID=

# Paths the Activity uses through Discord's proxy. Defaults suit the URL
# mappings described in docs/discord.md; override if yours differ.
# VITE_DISCORD_WS_PATH=/.proxy/ws
# VITE_DISCORD_TOKEN_PATH=/.proxy/api/discord/token
