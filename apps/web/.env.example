# Where the game server lives.
#
# Only needed when the client and the server are on different hosts — a
# production build with no value here talks to `/ws` on its own origin, which is
# what the Docker image serves. Development defaults to the local server.
# VITE_FLENS_SERVER=ws://localhost:8787

# Discord Activity. Baked into the bundle at build time (Vite substitutes it
# statically), so it is a --build-arg for the Docker build, not a runtime value.
# From the Developer Portal → your application → OAuth2 → Client ID.
VITE_DISCORD_CLIENT_ID=

# Paths the Activity uses through Discord's proxy. Defaults suit the single
# root URL mapping described in docs/discord.md; override if yours differs.
# VITE_DISCORD_WS_PATH=/.proxy/ws
# VITE_DISCORD_TOKEN_PATH=/.proxy/api/discord/token
