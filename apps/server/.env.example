PORT=8787
# HOST=0.0.0.0

# Where the built web app lives. Set it and the server serves the client too,
# which is what makes the Discord Activity a single host and a single URL
# mapping. Defaults to ../../web/dist, so `npm run build --workspace @flens/web`
# is enough locally. Leave the directory absent in development: Vite serves it.
# WEB_DIR=/app/apps/web/dist

# Required only for the Discord Activity: the server exchanges the OAuth code
# for an access token, because the client secret must never reach the browser.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
